{
  "name": "@daracl/form",
  "version": "0.0.17",
  "sideEffects": false,
  "description": "Daracl form validation ",
  "author": {
    "name": "darainfo",
    "email": "darainfosys@gmail.com",
    "url": "https://www.moaview.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darainfo/daracl.form.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "keywords": [
    "@daracl/form",
    "daraclValidation",
    "daracl-validation",
    "daraclForm",
    "daracl-form",
    "form",
    "validation",
    "darainfo",
    "javascript"
  ],
  "main": "src/index.ts",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/darainfo/daracl.form",
  "bugs": {
    "url": "https://github.com/darainfo/daracl.form/issues",
    "email": "darainfosys@gmail.com"
  },
  "exports": {
    ".": "./dist/index.js",
    "./dist/": "./dist/",
    "./style/": "./style/"
  },
  "files": [
    "dist",
    "style"
  ],
  "prettier": {
    "printWidth": 256,
    "useTabs": false,
    "tabWidth": 2,
    "bracketSpacing": true,
    "semi": true,
    "singleQuote": false
  },
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "peerDependencies": {
    "@daracl/core": "^0.0.3",
    "@daracl/toast": "^0.0.10",
    "@daracl/tree": "^0.0.11"
  },
  "dependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "init": "^0.1.2",
    "ink-docstrap": "^1.3.2",
    "preact": "^10.13.2",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0"
  },
  "devDependencies": {
    "@daracl/core": "^0.0.3",
    "@daracl/toast": "^0.0.10",
    "@daracl/tree": "^0.0.11",
    "@daracl/datetimepicker": "^0.0.9",
    "@mxssfd/typedoc-theme": "^1.1.1",
    "@types/file-saver": "^2.0.5",
    "@types/jest": "^29.5.1",
    "@types/node": "^20.1.0",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "cpx": "^1.5.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "esbuild": "^0.19.2",
    "esbuild-sass-plugin": "^2.12.0",
    "eslint": "^8.40.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "file-loader": "^6.2.0",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "jest": "^29.0.0",
    "material-icons": "^1.13.8",
    "mini-css-extract-plugin": "^2.7.6",
    "prettier": "^2.8.8",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.80.2",
    "sass-loader": "^16.0.2",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.2",
    "typedoc": "^0.26.7",
    "typescript": "^5.1.6",
    "url-loader": "^4.1.1",
    "vite": "^5.4.0",
    "vite-plugin-banner": "^0.7.1"
  },
  "scripts": {
    "prepack": "yarn build",
    
    "build": "vite build --mode production && vite build --mode development && yarn copy-dts && yarn build:tsc && yarn copy-unmin && yarn clean:unmin && yarn copy-html",
    "build:tsc": "tsc --emitDeclarationOnly",

    
    "build:vender": "webpack --config webpack.vender.js",
    "build:dev": "webpack --config webpack.dev.js",
    "build:prod": "webpack --config webpack.prod.js && webpack --env=mode=deploy --config webpack.dev.js",
    "preview": "vite preview",
    "dev": "vite",
    "dts:gen": "npx -p typescript tsc src/index.js --declaration --allowJs --emitDeclarationOnly --outDir dist",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "test": "jest",
    "start": "webpack-dev-server --config ./webpack.dev.server.js",
    "clean:unmin": "rimraf dist/unmin",
    "copy-html": "cpx \"public/index.html\" dist",
    "copy-unmin": "cpx \"dist/unmin/**.*\" dist",
    "copy-dts": "cpx \"src/**/*.d.ts\" dist"
  }
}
